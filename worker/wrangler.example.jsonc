{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karrooz-telegram-worker",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "production",
    // Public non-secret project metadata
    "FIREBASE_PROJECT_ID": "gen-lang-client-0985101866",
    "FIRESTORE_DATABASE_ID": "ai-studio-karrooz-88dd94b4-bce7-4ddc-8723-1bca334db048",
    "APP_URL": "https://karrooz.web.app",
    "TIMEZONE": "Asia/Tehran"
  }
  // Secrets to configure via Cloudflare Dashboard or `wrangler secret put <NAME>`:
  // - TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather
  // - TELEGRAM_WEBHOOK_SECRET: Secret token for X-Telegram-Bot-Api-Secret-Token validation
  // - FIREBASE_SERVICE_ACCOUNT_JSON: Service account key JSON with Cloud Datastore User role
}
